{
  "dependencies": [
    {
      "name": "carbon-blue",
      "version>=": "6.2.0"
    },
    {
      "name": "carbon-math",
      "version>=": "1.2.1"
    },
    {
      "name": "carbon-trinityaudioapi",
      "version>=": "3.1.0"
    },
    {
      "name": "wwise",
      "version>=": "2025.1.5.9095"
    },
    {
      "name": "python3",
      "version>=": "3.12.9#1"
    },
    {
      "name": "tbb"
    },
    {
      "name": "carbon-exefile",
      "version>=": "4.1.1",
      "host": true
    },
    {
      "name": "carbon-core",
      "version>=": "3.0.1"
    }
  ],
  "features": {
    "tools": {
      "description": "Developer tools, such as the Audio Lab (CARBON_AUDIO_BUILD_TOOLS=ON)",
      "dependencies": [
        {
          "name": "imgui",
          "features": [
            { "name": "dx11-binding", "platform": "windows" },
            { "name": "win32-binding", "platform": "windows" },
            { "name": "metal-binding", "platform": "osx" },
            { "name": "osx-binding", "platform": "osx" }
          ]
        },
        "nlohmann-json"
      ]
    }
  },
  "overrides": [
    {
      "name": "openssl",
      "version": "1.1.1k#8"
    }
  ]
}
